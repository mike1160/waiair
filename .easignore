# .easignore replaces .gitignore for EAS uploads — keep both in sync for deps, generated files and secrets.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native: Android is generated on EAS (prebuild); the committed ios/ is uploaded as-is, minus Pods,
# except hermes-engine, which the build needs from the archive.
/android
ios/Pods/
!ios/Pods/hermes-engine/
ios/build/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Local build outputs (eas build --local, downloaded artifacts)
*.ipa
*.apk
*.aab

# Kids mode artwork: the app ships the size-optimised copies in assets/kids-app/ (1.1 MB);
# the 19 MB originals stay on this machine.
/assets/kids/

# Metro
.metro-health-check*

# debug / logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.ips
/Retired/
/DiagnosticLogs/
/ota_patch.txt
.tmp-submit-debug.log

# macOS
.DS_Store
*.pem

# env / secrets (every EXPO_PUBLIC_* value is an EAS environment variable)
.env
.env*.local
.env.save

# generated svg previews (qlmanage)
lib/*.svg.png

# Cloudflare
.wrangler/
.dev.vars
