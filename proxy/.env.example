PORT=3001
# AeroDataBox via RapidAPI — required: the proxy refuses to start without it.
# Local: proxy/.env. Production: Railway service variables. Never commit a real key.
RAPIDAPI_KEY=
# Flight tracking credits (RevenueCat Virtual Currency). /credits returns 503 until all are set (plus DATABASE_URL).
# v2 secret key with Read & Write for Customer Configuration and Customer Purchases Configuration.
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_CREDITS_CODE=CREDITS
# Long random string (e.g. `openssl rand -hex 32`); signs proxy session tokens.
CREDITS_SESSION_SECRET=
# ID token audiences: iOS bundle ID(s) for Sign in with Apple, OAuth web client ID(s) for Google.
APPLE_BUNDLE_IDS=com.waiair.WaiAir
GOOGLE_CLIENT_IDS=
# LINE Messaging API channel of the WaiAir OA — POST /webhook/line and TRACK push messages.
# Without LINE_OA_CHANNEL_ACCESS_TOKEN the proxy issues a 30-day token from the channel ID + secret.
LINE_OA_CHANNEL_SECRET=
LINE_OA_CHANNEL_ID=
LINE_OA_CHANNEL_ACCESS_TOKEN=
# LIFF / LINE Login channel (waiair.app/liff, "Continue with LINE"). The webhook only falls back to
# LINE_CHANNEL_* when LINE_OA_* is unset. LINE_LOGIN_CHANNEL_ID overrides the channel app logins are verified against.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ID=
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
OPENWEATHER_API_KEY=
FLIGHTAWARE_API_KEY=
EXPO_PUBLIC_FA_ENABLED=true
SCHIPHOL_APP_ID=
SCHIPHOL_APP_KEY=
