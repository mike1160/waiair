{
  "expo": {
    "name": "WaiAir",
    "slug": "waiair",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "buildNumber": "11",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B1F3A"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WaiAir uses your location to select the nearest airport.",
        "NSCameraUsageDescription": "WaiAir uses your camera to scan boarding pass barcodes.",
        "NSCalendarsUsageDescription": "WaiAir needs calendar access to add your flight as an event.",
        "NSCalendarsFullAccessUsageDescription": "WaiAir needs calendar access to add your flight as an event.",
        "NSSupportsLiveActivities": true,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "grab",
          "bolt",
          "whatsapp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.waiair.WaiAir"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B1F3A"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "package": "com.waiair.WaiAir"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/fa77ac74-c0b8-4035-8f7f-f417436f93c7"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow WaiAir to use your location to select the nearest airport."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WaiAir to access your camera to scan boarding pass barcodes.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow WaiAir to add flight events to your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1d4ed8",
          "defaultChannel": "flights"
        }
      ],
      "expo-font",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.waiair.WaiAir.widgets",
          "groupIdentifier": "group.com.waiair.WaiAir",
          "widgets": [
            {
              "name": "FlightHomeWidget",
              "displayName": "WaiAir Flight",
              "description": "Your next tracked flight at a glance",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa77ac74-c0b8-4035-8f7f-f417436f93c7"
      }
    }
  }
}
