{
  "expo": {
    "name": "WaiAir",
    "slug": "WaiAir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3A"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WaiAir uses your location to select the nearest airport.",
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "grab",
          "grab"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.waiair.WaiAir"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.waiair.WaiAir"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow WaiAir to use your location to select the nearest airport."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1d4ed8",
          "defaultChannel": "flights"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aacfc0dd-5233-4d0e-b74d-96c6d68c8bbb"
      }
    }
  }
}
