EXPO_PUBLIC_PROXY_URL=https://waiair-production.up.railway.app
EXPO_PUBLIC_OPENWEATHER_API_KEY=
EXPO_PUBLIC_EXCHANGE_API_KEY=
EXPO_PUBLIC_AERODATABOX_KEY=
# RevenueCat Google Play public SDK key (Android). iOS key is in lib/purchases.ts.
EXPO_PUBLIC_RC_GOOGLE_KEY=
# FlightAware AeroAPI (Pro tracked flights only). Leave empty to disable.
# Kill switch: set EXPO_PUBLIC_FA_ENABLED=false then publish an OTA update.
EXPO_PUBLIC_FA_ENABLED=true
EXPO_PUBLIC_FLIGHTAWARE_KEY=
# Server-side key for the Railway proxy (preferred — not shipped in the app).
FLIGHTAWARE_API_KEY=
# Optional Supabase (Flight Race realtime). Falls back to WaiAir proxy when empty.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Schiphol Public Flight API (AMS gate / terminal / baggage). Keep secrets in .env only.
EXPO_PUBLIC_SCHIPHOL_APP_ID=
EXPO_PUBLIC_SCHIPHOL_APP_KEY=
SCHIPHOL_APP_ID=
SCHIPHOL_APP_KEY=
# Aviasales / Travelpayouts Data API (client: EXPO_PUBLIC_ prefix is required for Expo)
# Affiliate marker + campaign IDs live in lib/affiliateConfig.ts — put the token here, never in components.
AVIASALES_TOKEN=
EXPO_PUBLIC_AVIASALES_TOKEN=
# Mapbox public token for RouteHero flight map tiles (mapbox/dark-v11)
EXPO_PUBLIC_MAPBOX_TOKEN=
# Google Maps SDK key for react-native-maps on Android (EAS secret: GOOGLE_MAPS_API_KEY)
GOOGLE_MAPS_API_KEY=
