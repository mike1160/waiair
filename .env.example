EXPO_PUBLIC_PROXY_URL=https://waiair-production.up.railway.app
EXPO_PUBLIC_OPENWEATHER_API_KEY=
EXPO_PUBLIC_EXCHANGE_API_KEY=
EXPO_PUBLIC_AERODATABOX_KEY=
# RevenueCat Google Play public SDK key (Android). iOS key is in lib/purchases.ts.
EXPO_PUBLIC_RC_GOOGLE_KEY=
# FlightAware AeroAPI (Pro tracked flights only). Leave empty to disable.
# Kill switch: set EXPO_PUBLIC_FA_ENABLED=false then publish an OTA update.
EXPO_PUBLIC_FA_ENABLED=true
EXPO_PUBLIC_FLIGHTAWARE_KEY=
# Server-side key for the Railway proxy (preferred — not shipped in the app).
FLIGHTAWARE_API_KEY=
# Optional LoungeReview API (loungereview.com). Empty = hardcoded lounge data.
EXPO_PUBLIC_LOUNGEREVIEW_KEY=
